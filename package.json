{
  "name": "crush-monitor",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1 -TestOnly",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File android/build.ps1",
    "install:android": "powershell -NoProfile -ExecutionPolicy Bypass -File android/build.ps1 -Install",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check:live": "tsx scripts/check-live.ts",
    "setup": "tsx scripts/setup.ts",
    "check:api": "tsx scripts/check-api.ts",
    "export:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "license": "MIT",
  "description": "Local-first conversation notebook for desktop and Android, powered by your own Jev API key",
  "engines": {
    "node": ">=22.12.0"
  }
}
