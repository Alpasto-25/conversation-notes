# Run npm run setup to choose a provider and paste its key.
# Choices: typesafe | vercel | openrouter | deepseek. URLs are fixed.
# DeepSeek model: deepseek-flash.
# Optional JEV_MODEL selects a model; DEEPSEEK_API_KEY is also supported.
JEV_PROVIDER=typesafe
JEV_API_KEY=
# Optional secondary model: keep Jev above and add a separate DeepSeek key.
# Used only for communication strategies and short subtext; never reused as the Jev key.
DEEPSEEK_API_KEY=
PORT=3178
HOST=127.0.0.1
