# Run npm run setup to choose a provider and paste its key.
# Choices: typesafe | vercel | openrouter | deepseek. URLs are fixed.
# DeepSeek models: deepseek-flash (default) | deepseek-v4-pro.
# Optional JEV_MODEL selects a model; DEEPSEEK_API_KEY is also supported.
JEV_PROVIDER=typesafe
JEV_API_KEY=
PORT=3178
HOST=127.0.0.1
